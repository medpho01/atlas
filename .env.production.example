# Atlas production env. Copy to .env.production and fill in.
# Do NOT commit .env.production — it's in .gitignore.

# ----------------------------------------------------------------------------
# SOURCE_DATABASE_URL — the operational LabStack DB.
# Read-only for Atlas. On a Linux VM with Postgres on the host, use
# host.docker.internal:5432 (the docker-compose extra_hosts mapping handles
# the Linux gateway routing automatically).
#
# Create a read-only role on the source DB:
#   CREATE ROLE atlas_reader LOGIN PASSWORD '<strong-pw>';
#   GRANT CONNECT ON DATABASE labstack TO atlas_reader;
#   GRANT USAGE ON SCHEMA public TO atlas_reader;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO atlas_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO atlas_reader;
# ----------------------------------------------------------------------------
SOURCE_DATABASE_URL=postgresql://atlas_reader:CHANGEME@host.docker.internal:5432/labstack

# ----------------------------------------------------------------------------
# APP_DATABASE_URL — Atlas's own DB, hosted by the atlas-db service in this
# docker-compose stack.
# Default works out of the box; only set this explicitly if you want
# atlas-web to point at a managed Postgres instead.
# ----------------------------------------------------------------------------
# APP_DATABASE_URL=postgres://atlas:atlas@atlas-db:5432/atlas

# ----------------------------------------------------------------------------
# ATLAS_DB_PASSWORD — Postgres password for the atlas-db container.
# Used by both the Postgres init and the default APP_DATABASE_URL above.
# Change before exposing the host's 5433 port to anything you don't trust.
# ----------------------------------------------------------------------------
ATLAS_DB_PASSWORD=atlas

# ----------------------------------------------------------------------------
# APP_URL — public origin Atlas is served at. Used for absolute redirect URLs
# (e.g. on logout). Include scheme; no trailing slash.
# ----------------------------------------------------------------------------
APP_URL=https://atlas.your-domain.example

# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY — web search for labs in supply-gap pincodes.
#
# Used by lib/discoverLabs.ts (the request detail page) and by
# scripts/discover-labs.ts (the nightly batch). Without it the search refuses
# to run and says so on the card.
#
# It has to be in THIS file, not .env. The app is what compose loads
# .env.production into, while the enrich shell scripts also read .env — so a
# key present in only one of them produces the confusing case where a working
# curl from the shell and a failing search in the app are using different
# credentials. The error message on the card names this file for that reason,
# and reports the last four characters of whichever key it actually used.
#
# Since the request detail page now searches on page load for a pincode the
# network cannot reach, a missing key is the first thing a fresh deploy hits.
# Discovery is the only feature that needs it; everything else works without.
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-CHANGEME

# ----------------------------------------------------------------------------
# DISCOVERY_ENABLED — web lab discovery, off by default.
#
# The feature works: a search for 413736 returned three real, callable labs.
# It was off because it cost about $1.50 a pincode — a language model reading
# the open web for a name, an address, a phone number, a rating and a review
# count, which is what a places API returns for a fraction of that, in under a
# second. The ranking does not care where those fields come from, so the source
# changed rather than the feature: see DISCOVERY_SOURCES below.
#
# Turning this on now buys places-API lookups, not model calls — a sweep of the
# supply-gap pincodes costs cents rather than hundreds of dollars. The model is
# behind its own switch, DISCOVERY_LLM_FALLBACK, and stays off.
#
# Set to "on" to enable. Nothing is claimed, nothing is searched and nothing is
# billed while it is off; leads already found are still shown.
# ----------------------------------------------------------------------------
# DISCOVERY_ENABLED=on

# ----------------------------------------------------------------------------
# DISCOVERY_SOURCES — where leads come from, in order.
#
# Walked until a pincode has DISCOVERY_MIN_LEADS, so a pincode a free Indian
# directory can answer never reaches a metered one. A source with no credential
# is skipped, not failed: the chain moves on.
#
# The order is not arbitrary. Mappls and Ola are Indian directories of Indian
# businesses, with better small-town coverage than a global provider, free or
# near-free at this volume, and no terms restricting how long a name, address
# and phone may be kept — which matters, because promoting a lead into CRM is
# exactly that retention. Google has the best coverage and the only ratings
# worth having, and the tightest retention terms, so it fills gaps rather than
# leading. 23_discovery_source.sql records which source produced each row so
# the Google ones can be told apart.
# ----------------------------------------------------------------------------
# DISCOVERY_SOURCES=mappls,ola,google
# DISCOVERY_MIN_LEADS=2
# DISCOVERY_RADIUS_M=6000
# DISCOVERY_BUDGET_USD=15

# A source with no credential is skipped. `npm run test:discovery-sources`
# checks the parsing without needing any of these.
# MAPPLS_CLIENT_ID=
# MAPPLS_CLIENT_SECRET=
# OLA_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Per-pincode prices, USD. Estimates, overridable rather than compiled in as
# facts — a stale number here under-reports what discovery is costing.
# DISCOVERY_COST_MAPPLS_USD=0
# DISCOVERY_COST_OLA_USD=0.002
# DISCOVERY_COST_GOOGLE_USD=0.035

# ----------------------------------------------------------------------------
# DISCOVERY_LLM_FALLBACK — let the model answer when no places source could.
#
# Off by default, and separate from DISCOVERY_ENABLED on purpose. Turning
# discovery on should buy lookups at a fraction of a cent; it must not quietly
# re-enable the $1.50-a-pincode model sweep that got discovery switched off in
# the first place. Turn this on deliberately, knowing the price, and only for
# the pincodes the directories cannot see.
#
# DISCOVERY_MAX_USES below applies only to this path.
# ----------------------------------------------------------------------------
# DISCOVERY_LLM_FALLBACK=off

# ----------------------------------------------------------------------------
# DISCOVERY_MAX_USES — how many web searches one lab discovery may make.
#
# The biggest lever on what this feature costs. Default 10. Each use pulls page
# content back through the model and the server-side loop re-reads the growing
# conversation, so cost grows faster than the count: a verified answer for one
# pincode is on the order of a dollar.
#
# Below about 5 searches come back empty — the model runs out of budget, says
# "server tool use limit exceeded", and correctly refuses to invent labs.
# ----------------------------------------------------------------------------
# DISCOVERY_MAX_USES=10

# DISCOVERY_AUTO_SEARCH=on makes the request page search on load instead of
# waiting for a click. Off by default, deliberately — it spends money on every
# open of a request somebody is only reading.
# DISCOVERY_AUTO_SEARCH=off
