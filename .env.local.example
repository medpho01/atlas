# Local development. Copy to .env.local, or let scripts/setup-local.sh write it.
# Never commit .env.local or .env.production — both hold credentials.

# Atlas's own database: users, sessions, CRM, commitments, and the analytics
# views. scripts/setup-local.sh starts this container for you.
APP_DATABASE_URL=postgres://atlas:atlas@localhost:15432/atlas

# Where the analytics views are read from. The same database locally; also the
# same in production, since the views are materialised in atlas-db.
DATABASE_URL=postgres://atlas:atlas@localhost:15432/atlas

# CRM document uploads.
UPLOADS_DIR=./.uploads

# ---------------------------------------------------------------------------
# Everything below is optional. Every page works without it.
# ---------------------------------------------------------------------------

# The LabStack replica. Leave this unset locally: the sample data already sits
# in src_local, and nothing in the app reads the source directly. Only the FDW
# bootstrap and the nightly refresh use it. See docs/LOCAL-SETUP.md.
# SOURCE_DATABASE_URL=

# Only the lab-discovery and catalogue-enrichment scripts call the API.
# ANTHROPIC_API_KEY=

# Absolute base URL, for links built outside a request.
# APP_URL=http://localhost:3010

# Reach radii, in km. Defaults live in lib/publicNetwork.ts.
# CV_REACH_RADIUS_KM=10
# PHLEBO_REACH_RADIUS_KM=10
# NURSE_REACH_RADIUS_KM=10
